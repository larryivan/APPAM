# 服务器配置
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=25079
FLASK_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
APPAM_ALLOW_UNSAFE_WERKZEUG=false
SESSION_COOKIE_SECURE=false

# Paths
APPAM_REPO_ROOT=/opt/appam
APPAM_BACKEND_ROOT=/opt/appam/backend
APPAM_PROJECTS_ROOT=/workspaces/projects
APPAM_DATABASES_ROOT=/databases
APPAM_DB_MANIFEST=/databases/appam-db-manifest.json

# Local executor
PIPELINE_JOB_TIMEOUT=604800
APPAM_DB_PATH=/data/app_database.db
SOCKETIO_ASYNC_MODE=threading
APPAM_GUNICORN_THREADS=32
APPAM_GUNICORN_TIMEOUT=120
APPAM_GUNICORN_GRACEFUL_TIMEOUT=30
APPAM_QUEUE_BACKEND=local-db
APPAM_REDIS_URL=redis://redis:6379/0
APPAM_RQ_QUEUE=appam-workflows
APPAM_RQ_WORKER_NAME=
APPAM_MAX_GLOBAL_QUEUED=100
APPAM_MAX_PROJECT_QUEUED=10
APPAM_MAX_USER_QUEUED=10
APPAM_PREFLIGHT_DRY_RUN=true
APPAM_PREFLIGHT_DRY_RUN_TIMEOUT=120
APPAM_ALLOW_RUNTIME_DRIFT_ON_RETRY=false

# Prefer `python manage.py create-admin --username labadmin` for an interactive first admin.
# The environment bootstrap is retained for unattended provisioning.
# APPAM_BOOTSTRAP_ADMINS supports: username:password[:display_name];second:password[:display_name]
# Use APPAM_BOOTSTRAP_ADMINS_JSON for passwords containing separators or richer names.
APPAM_BOOTSTRAP_ADMINS=
APPAM_BOOTSTRAP_ADMINS_JSON=
APPAM_BOOTSTRAP_ADMIN_RESET_PASSWORDS=false
APPAM_ALLOW_REGISTRATION=false
APPAM_ALLOW_FIRST_USER_ADMIN=false
APPAM_ALLOWED_ORIGINS=
APPAM_TRUST_PROXY_HEADERS=true
APPAM_ALLOW_FTP_DOWNLOADS=false
APPAM_REMOTE_DOWNLOAD_HOSTS=
APPAM_MAX_REMOTE_DOWNLOAD_BYTES=107374182400
APPAM_MAX_GLOBAL_DOWNLOADS=8
APPAM_MAX_PROJECT_DOWNLOADS=2
APPAM_MAX_DOWNLOAD_THREADS=8
APPAM_DOWNLOAD_HISTORY_DAYS=30
APPAM_MAX_UPLOAD_CHUNK_BYTES=16777216
APPAM_MAX_PLOT_TABLE_BYTES=8388608
APPAM_MAX_PLOT_TABLE_ROWS=50000
APPAM_MAX_UPLOAD_CHUNKS=20000
APPAM_MAX_REQUEST_BYTES=17825792

# Snakemake and workflow runtime
APPAM_SNAKEMAKE_BIN=snakemake
APPAM_SMK_ROOT=/opt/appam/APPAM-SMK-main
APPAM_SMK_METAWRAP_ENV=/opt/conda/envs/metawrap
APPAM_SMK_PREPROCESSING_ENV=/opt/conda/envs/preprocessing
APPAM_SMK_MAPPING_ENV=/opt/conda/envs/mapping_dna
APPAM_SMK_ASSEMBLY_ENV=/opt/conda/envs/assembly
APPAM_SMK_PYDAMAGE_ENV=/opt/conda/envs/ancient_dna
APPAM_SMK_CHECKM1_ENV=/opt/conda/envs/checkm
APPAM_SMK_CHECKM1_DB=/databases/checkm
APPAM_SMK_CHECKM_DB=/databases/checkm
APPAM_SMK_CHECKM2_ENV=/opt/conda/envs/checkm2
APPAM_SMK_CHECKM2_DB=/databases/checkm2
APPAM_SMK_GUNC_ENV=/opt/conda/envs/binning
APPAM_SMK_GUNC_DB=/databases/gunc
APPAM_SMK_GTDBTK_ENV=/opt/conda/envs/gtdbtk
APPAM_SMK_GTDBTK_DB=/databases/gtdbtk_r226
APPAM_SMK_PROKKA_ENV=/opt/conda/envs/prokka
APPAM_SMK_EGGNOG_ENV=/opt/conda/envs/eggnog_py310
APPAM_SMK_EGGNOG_DB=/databases/eggnog
APPAM_KRAKENUNIQ_DB=/databases/krakenuniq_refseq_bav
APPAM_SMK_ABRICATE_ENV=/opt/conda/envs/abricate
APPAM_SMK_RGI_ENV=/opt/conda/envs/rgi
APPAM_SMK_RGI_DB_MODE=global
APPAM_SMK_ANTISMASH_ENV=/opt/conda/envs/antismash
APPAM_SMK_FREEBAYES_ENV=/opt/conda/envs/freebayes
APPAM_SMK_BCFTOOLS_ENV=/opt/conda/envs/bcftools
APPAM_SMK_REPORTING_ENV=/opt/conda/envs/reporting
APPAM_PALEOPROTEOMICS_ROOT=/opt/appam/appam-paleoproteomics-main
APPAM_PALEO_ENV=/opt/conda/envs/paleoproteomics
APPAM_PALEO_TIMSCONVERT_ENV=/opt/conda/envs/timsconvert
APPAM_PALEO_DOTNET_BIN=dotnet
APPAM_PALEO_MAXQUANT_CMD=/opt/tools/maxquant-current/bin/MaxQuantCmd.dll
APPAM_PALEO_MAXQUANT_VERSION=2.8.1.0
APPAM_PALEO_THERMO_RAW_FILE_PARSER=ThermoRawFileParser
APPAM_PALEO_TIMSCONVERT_BIN=timsconvert
APPAM_PALEO_OPENMS_FILECONVERTER=FileConverter

# OpenCode integration (API service)
OPENCODE_PORT=19455
OPENCODE_BASE_URL=http://127.0.0.1:19455
OPENCODE_API_AGENT=plan
# OPENCODE_PROVIDER_ID=anthropic
# OPENCODE_MODEL_ID=claude-3-5-sonnet
OPENCODE_TIMEOUT=120
OPENCODE_SYSTEM_PROMPT_PATH=opencode/system_prompt.txt
OPENCODE_AGENTS_TEMPLATE_PATH=opencode/AGENTS.md
OPENCODE_SKILL_PATH=
OPENCODE_SKILL_FILENAMES=SKILL.md,skill.md
# API suggestion sessions deny every tool by default. Add only read-only permissions if required.
OPENCODE_PERMISSIONS=
OPENCODE_PERMISSION_PATTERN=*
# OPENCODE_IGNORE_PROXY=true
# NO_PROXY=127.0.0.1,localhost,0.0.0.0
# no_proxy=127.0.0.1,localhost,0.0.0.0

# OpenCode CLI integration (terminal UI)
OPENCODE_CLI_COMMAND=opencode
OPENCODE_CLI_AGENT=build
OPENCODE_CLI_AGENTS_PATH=/opt/appam/backend/opencode/AGENTS.md
OPENCODE_CLI_SYSTEM_PROMPT_PATH=/opt/appam/backend/opencode/system_prompt.txt
# OPENCODE_LLM_PROVIDER_ID=openai
# OPENCODE_LLM_MODEL=gpt-4o-mini
OPENCODE_LLM_API_KEY=
OPENCODE_LLM_BASE_URL=
