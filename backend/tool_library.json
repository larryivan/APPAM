      { "name": "-s", "description": "Require same strandedness", "type": "flag", "default": false },
      { "name": "-S", "description": "Require different strandedness", "type": "flag", "default": false },
      { "name": "output_file", "description": "Output BED-like table", "type": "string", "default": "results/bedtools/intersect.tsv", "path_role": "output", "path_kind": "file", "stream": "stdout", "required": true }
