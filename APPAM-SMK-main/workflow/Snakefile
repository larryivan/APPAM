# Snakefile
configfile: "config/config.yaml"

include: "rules/common.smk"

RAW_DATA_DIR = config["paths"]["raw_data_dir"]
RESULTS_DIR = config["paths"]["results_dir"]
PREPROCESS_DIR = f"{RESULTS_DIR}/preprocess"
LOGS_DIR = config["paths"]["logs_dir"]
BENCHMARK_DIR = config["paths"]["benchmark_dir"]
SAMPLE_ROWS = load_samples(config["samples_file"], RAW_DATA_DIR)
SAMPLES = list(SAMPLE_ROWS)
PREPROCESS_METHOD = config["params"].get("preprocess_method", "fastp").lower()
ENABLE_BIN_REFINEMENT = bool(config["params"].get("enable_bin_refinement", False))
UNREFINED_BINNER = str(config["params"].get("unrefined_binner", "metabat2")).lower()
BIN_COMPLETENESS = int(config["params"].get("bin_completeness", 50))
BIN_CONTAMINATION = int(config["params"].get("bin_contamination", 10))
ENABLE_VARIANTS = bool(config["params"].get("enable_variants", False))
ENABLE_VISUALIZATION = bool(config.get("visualization", {}).get("enabled", True))

if UNREFINED_BINNER not in {"metabat2", "maxbin2", "concoct"}:
    raise ValueError("params.unrefined_binner must be metabat2, maxbin2, or concoct")

FINAL_BINS_PATTERN = (
    f"{RESULTS_DIR}/metawrap/bin_refinement/{{sample}}/"
    f"metawrap_{BIN_COMPLETENESS}_{BIN_CONTAMINATION}_bins"
    if ENABLE_BIN_REFINEMENT
    else f"{RESULTS_DIR}/metawrap/binning/{{sample}}/{UNREFINED_BINNER}_bins"
)

if PREPROCESS_METHOD not in {"adapter_removal", "fastp"}:
    raise ValueError(
        "params.preprocess_method must be either 'adapter_removal' or 'fastp'. "
        f"Got: {PREPROCESS_METHOD}"
    )

include: "rules/preprocess.smk"
include: "rules/assembly.smk"
include: "rules/damage.smk"
include: "rules/contigs_filter.smk"
include: "rules/binning.smk"
include: "rules/classify.smk"
include: "rules/annotation.smk"
include: "rules/variants.smk"
include: "rules/summary.smk"
include: "rules/visualization.smk"

BINNING_TARGETS = [
    *expand(FINAL_BINS_PATTERN, sample=SAMPLES),
]
if config["params"].get("enable_checkm1", False):
    BINNING_TARGETS += expand(f"{RESULTS_DIR}/checkm/{{sample}}/bins_qa.txt", sample=SAMPLES)
if config["params"].get("enable_checkm2", True):
    BINNING_TARGETS += expand(f"{RESULTS_DIR}/checkm2/{{sample}}/quality_report.tsv", sample=SAMPLES)
if config["params"].get("enable_gunc", True):
    BINNING_TARGETS += expand(f"{RESULTS_DIR}/gunc/{{sample}}/GUNC.progenomes_2.1.maxCSS_level.tsv", sample=SAMPLES)

ANNOTATION_TARGETS = []
if config["params"].get("enable_gtdbtk", True):
    ANNOTATION_TARGETS += expand(f"{RESULTS_DIR}/gtdbtk/{{sample}}/classify_wf.done", sample=SAMPLES)
if config["params"].get("enable_prokka", True):
    ANNOTATION_TARGETS += expand(f"{RESULTS_DIR}/annotation/prokka/{{sample}}/prokka.done", sample=SAMPLES)
if config["params"].get("enable_eggnog", False):
    ANNOTATION_TARGETS += expand(f"{RESULTS_DIR}/annotation/eggnog/{{sample}}/eggnog.done", sample=SAMPLES)
if config["params"].get("enable_abricate", False):
    ANNOTATION_TARGETS += expand(f"{RESULTS_DIR}/annotation/abricate/{{sample}}/abricate.done", sample=SAMPLES)
if config["params"].get("enable_rgi", False):
    ANNOTATION_TARGETS += expand(f"{RESULTS_DIR}/annotation/rgi/{{sample}}/rgi.done", sample=SAMPLES)
if config["params"].get("enable_antismash", False):
    ANNOTATION_TARGETS += expand(f"{RESULTS_DIR}/annotation/antismash/{{sample}}/antismash.done", sample=SAMPLES)

VARIANT_TARGETS = []
if ENABLE_VARIANTS:
    VARIANT_TARGETS = [
        *expand(f"{RESULTS_DIR}/variants/{{sample}}/{{sample}}.filtered.vcf.gz", sample=SAMPLES),
        *expand(f"{RESULTS_DIR}/consensus/{{sample}}.consensus.fa.gz", sample=SAMPLES),
    ]

REPORT_TARGETS = [f"{RESULTS_DIR}/summaries/MAG_summary.tsv"]
if ENABLE_VISUALIZATION:
    REPORT_TARGETS += [
        f"{VISUALIZATION_DIR}/report.html",
        f"{VISUALIZATION_DIR}/report-data.json",
    ]

# optional messages, log and error handling
# -----------------------------------------------------
onstart:
    print("\n--- Analysis started ---\n")


onsuccess:
    print("\n--- Workflow finished! ---\n")


onerror:
    print("\n--- An error occurred! ---\n")


# target rules
# -----------------------------------------------------
rule all:
    input:
        (
            [
                *expand(f"{PREPROCESS_DIR}/{{sample}}.fastp.html", sample=SAMPLES),
                *expand(f"{PREPROCESS_DIR}/{{sample}}.fastp.json", sample=SAMPLES),
            ]
            if PREPROCESS_METHOD == "fastp"
            else [
                *expand(f"{PREPROCESS_DIR}/{{sample}}_R1_fastqc.html", sample=SAMPLES),
                *expand(f"{PREPROCESS_DIR}/{{sample}}_R2_fastqc.html", sample=SAMPLES),
                *expand(f"{PREPROCESS_DIR}/{{sample}}.collapsed.gz", sample=SAMPLES),
            ]
        )
        + [
            *expand(f"{PREPROCESS_DIR}/{{sample}}.paired_R1.fastq.gz", sample=SAMPLES),
            *expand(f"{PREPROCESS_DIR}/{{sample}}.paired_R2.fastq.gz", sample=SAMPLES),
            *expand(f"{PREPROCESS_DIR}/{{sample}}.single.fastq.gz", sample=SAMPLES),
            *expand(f"{PREPROCESS_DIR}/{{sample}}.all.single.fastq.gz", sample=SAMPLES),
            # Assembly
            *expand(f"{RESULTS_DIR}/megahit/{{sample}}/final.contigs.fa", sample=SAMPLES),
            # Damage
            *expand(f"{RESULTS_DIR}/pydamage/{{sample}}/pydamage_results.csv", sample=SAMPLES),
            # Binning & bin quality
            *BINNING_TARGETS,
            *ANNOTATION_TARGETS,
            *VARIANT_TARGETS,
            *REPORT_TARGETS,
        ]
    default_target: True
